# Tielora — copy this file to .env for local development.
# The values below are LOCAL-DEV-ONLY credentials for the throwaway Postgres on this machine.
# They are not secrets and must never be reused for a real deployment.
# Every variable the app reads is listed here. Real values live only in the hosting dashboard.

# ---------------------------------------------------------------------------
# Required everywhere
# ---------------------------------------------------------------------------

# Development database (Postgres 16, with the pg_trgm and unaccent extensions available).
DATABASE_URL="postgresql://nexus:nexus_dev_pw@localhost:5432/nexus"

# Test database — used by the verify recipe (prisma migrate deploy) and the service tests.
# The tests empty it between runs, so never point this at data you care about.
DATABASE_URL_TEST="postgresql://nexus:nexus_dev_pw@localhost:5432/nexus_test"

# Where uploaded files are written (the app puts them under DATA_DIR/uploads). Kept out of git.
# RUN TIME ONLY: it is not checked while the app is built (no volume is mounted then). A running
# production server refuses to start if it is unset or cannot be written to.
DATA_DIR="./data"

# Signing secret for session cookies.
# Generate 32+ random bytes, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app refuses to start in production with a short or missing secret — and it must be present at
# BUILD time too, because building renders pages, which loads the session code.
SESSION_SECRET="local-dev-only-secret-change-me-0123456789abcdef"

# ---------------------------------------------------------------------------
# Optional — everything below is dormant until you set it
# ---------------------------------------------------------------------------

# Server-side error tracking (Sentry). Leave empty and Sentry is never imported, never started, and
# /api/health reports "sentry": {"server": "dormant", ...}. Set it and the same route reports
# "server": "configured".
# Note: it must be present at BUILD time as well, because the Content-Security-Policy that
# allows the browser to reach Sentry's ingest host is baked into the build.
SENTRY_DSN=

# Browser-side error reporting, off by default. Only set this if you want errors from people's
# browsers as well as from the server; it is inlined into the JavaScript bundle at build time.
# /api/health reports it separately as "sentry": {..., "browser": "configured"}.
NEXT_PUBLIC_SENTRY_DSN=

# Share of requests traced by Sentry, 0 to 1. Errors are always captured; tracing costs quota.
SENTRY_TRACES_SAMPLE_RATE=0

# Where this copy of the app can be reached, e.g. https://tielora.example — no trailing slash.
# Used to turn an in-app path into a clickable link inside a Slack or Teams message — leave it unset
# and chat messages simply name the page instead of linking to it. It is also REQUIRED by Microsoft
# 365 attachments (the callback address is built from it) and by transactional email below: an
# invitation, a reset or a verification email is nothing but a link, so with no address to build one
# from, email stays dormant and sends nothing.
APP_BASE_URL=

# Transactional email (invitations, password resets, email verification), off until both are set.
# Leave them empty and no email is ever sent: the forgot-password page says resets are unavailable
# and points at the workspace administrator, the invite option is absent from Admin -> Users, and
# /api/health reports "email": "dormant". Nothing else in the app behaves differently.
# RESEND_API_KEY is a real secret from https://resend.com. EMAIL_FROM must be an address on a domain
# verified there, e.g. "Tielora <no-reply@tielora.example>".
RESEND_API_KEY=
EMAIL_FROM=

# Microsoft 365 file attachments (OneDrive and SharePoint), off until all of this is set.
# Leave them empty and the feature is invisible: no card in Admin -> Integrations, no tab in the
# upload box, and every /api/integrations/microsoft/... route answers "not set up".
# /api/health reports "microsoft": {"status": "dormant", "connectedOrgs": 0} until then.
# The two values come from an Azure app registration — the steps are in docs/GO-LIVE.md, section 6.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# Where Microsoft sends people back to after they sign in. Leave it empty to use
# /api/integrations/microsoft/callback, which is the address to register in Azure. Only set it if
# something in front of the app rewrites that path. It is combined with APP_BASE_URL, which must
# also be set for the connect button to work.
MS_GRAPH_REDIRECT_PATH=

# Chat integrations (Slack, Microsoft Teams) need no environment variable at all: each company
# pastes its own webhook address in Admin -> Integrations, and /api/health reports how many
# companies have each kind switched on ("integrations": {"slack": 0, "teams": 0} when nobody has).

# How many database connections this copy of the app keeps open. Default 10, which suits one
# instance. On several instances, keep (instances x DB_POOL_MAX) well under the database's own
# max_connections, or use a pooled DATABASE_URL.
DB_POOL_MAX=

# Set to 1 to stop the hourly deadline sweep (the "due soon" / "overdue" notifications).
# The tests set this. Nothing depends on the sweep having run — a skipped run costs a nudge,
# never correctness — so it is safe to switch off on a second instance or while debugging.
SWEEP_DISABLED=

