// Tielora — complete data model. FROZEN after Milestone 1: schema changes need main-session approval.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  DISCIPLINE_LEAD
  ENGINEER
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  AWAITING_REVIEW
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// OVERDUE is never stored on a task — it is derived at read time from the deadline.
enum NotificationType {
  ASSIGNED
  MENTIONED
  STATUS_CHANGED
  DEADLINE_APPROACHING
  OVERDUE
  DOCUMENT_UPLOADED
  COMMENT_ADDED
  OVERRIDE_APPLIED
}

/// One customer company. EVERY tenant-owned row reaches its organisation through this model:
/// a User, a Discipline and a Project each carry a required orgId, and everything else hangs off
/// one of those three. Nothing is ever shared between organisations.
model Organization {
  id     String @id @default(cuid())
  name   String
  /// The company's handle, unique across the whole product and derived from its name at signup.
  slug   String @unique
  /// Which discipline template the company started from: OIL_AND_GAS, CONSTRUCTION or GENERIC.
  industryTemplate String
  createdAt        DateTime @default(now())

  users        User[]
  disciplines  Discipline[]
  projects     Project[]
  integrations OrgIntegration[]
}

/// One company's chat-notification hook: where Tielora posts a copy of its notifications.
///
/// `kind` is a STRING validated by zod (IntegrationKindSchema in src/lib/zod-schemas.ts), not a
/// Prisma enum, so a third kind of chat tool needs no migration.
/// `webhookUrl` is a bearer secret — anyone holding it can post into that channel. It is never
/// returned by any read API and never written to an audit row or a log line; the admin screen only
/// ever sees scheme + host.
/// `eventToggles` is a small map of per-event booleans, again validated by zod on the way in.
/// In-app Notifications remain the source of truth: delivery here is best-effort.
model OrgIntegration {
  id           String   @id @default(cuid())
  orgId        String
  /// "SLACK" or "TEAMS" today. One row per kind per organisation.
  kind         String
  webhookUrl   String
  enabled      Boolean  @default(false)
  eventToggles Json
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("OrgIntegrationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([orgId, kind])
}

model User {
  id           String    @id @default(cuid())
  orgId        String
  /// Globally unique on purpose: one email address signs in to exactly one organisation, so the
  /// sign-in form never has to ask which company you meant.
  email        String    @unique // always stored lowercased
  name         String
  passwordHash String
  role         Role
  disciplineId String?
  jobTitle     String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  discipline   Discipline?  @relation(fields: [disciplineId], references: [id])

  sessions              Session[]
  createdProjects       Project[]           @relation("ProjectCreatedBy")
  disciplineLeaderships ProjectDiscipline[] @relation("ProjectDisciplineLead")
  memberships           ProjectMember[]
  createdMainTasks      MainTask[]          @relation("MainTaskCreatedBy")
  ownedMainTasks        MainTask[]          @relation("MainTaskOwner")
  overriddenMainTasks   MainTask[]          @relation("MainTaskOverriddenBy")
  overriddenPhases      ProjectPhase[]      @relation("ProjectPhaseOverriddenBy")
  assignedTasks         DisciplineTask[]    @relation("DisciplineTaskAssignee")
  tasksAssignedByMe     DisciplineTask[]    @relation("DisciplineTaskAssignedBy")
  tasksCompletedByMe    DisciplineTask[]    @relation("DisciplineTaskCompletedBy")
  uploadedDocuments     Document[]          @relation("DocumentUploadedBy")
  uploadedVersions      DocumentVersion[]   @relation("DocumentVersionUploadedBy")
  comments              Comment[]
  notifications         Notification[]      @relation("NotificationRecipient")
  actedNotifications    Notification[]      @relation("NotificationActor")
  activityLogs          ActivityLog[]
  favorites             Favorite[]
  personalTasks         PersonalTask[]
  createdIntegrations   OrgIntegration[]    @relation("OrgIntegrationCreatedBy")

  @@index([isActive])
  @@index([orgId, isActive])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256/HMAC hex of the raw token; the raw token only ever lives in the cookie
  userId    String
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Discipline {
  id        String   @id @default(cuid())
  orgId     String
  code      String
  name      String
  colorHex  String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  users              User[]
  projectDisciplines ProjectDiscipline[]
  projectMembers     ProjectMember[]
  disciplineTasks    DisciplineTask[]

  // Per organisation, not global: two companies may both run a "Civil" discipline.
  @@unique([orgId, code])
  @@unique([orgId, name])
}

model Project {
  id          String        @id @default(cuid())
  orgId       String
  name        String
  code        String
  description String
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  targetDate  DateTime?
  createdById String
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  disciplines ProjectDiscipline[]
  members     ProjectMember[]
  phases      ProjectPhase[]
  mainTasks   MainTask[]
  documents   Document[]
  activity    ActivityLog[]
  favorites   Favorite[]

  // Per organisation, not global: two companies may both run a project called "PH-1".
  @@unique([orgId, code])
  @@index([status])
  @@index([deletedAt])
  @@index([orgId, deletedAt])
}

model ProjectDiscipline {
  id           String   @id @default(cuid())
  projectId    String
  disciplineId String
  leadId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    Project    @relation(fields: [projectId], references: [id])
  discipline Discipline @relation(fields: [disciplineId], references: [id])
  lead       User?      @relation("ProjectDisciplineLead", fields: [leadId], references: [id])

  @@unique([projectId, disciplineId])
}

model ProjectMember {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  projectRole  Role
  disciplineId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    Project     @relation(fields: [projectId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  discipline Discipline? @relation(fields: [disciplineId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
}

/// A stage gate on a project. A phase is LOCKED while any phase before it (lower sortOrder) still
/// has a main task that is not complete — and "locked" is DERIVED at read time, never stored, in
/// exactly the way OVERDUE is. The only legal way past a gate is the recorded override below:
/// who, why (5 characters minimum) and when, with a PHASE_OVERRIDE_APPLIED audit row beside it.
model ProjectPhase {
  id             String    @id @default(cuid())
  projectId      String
  name           String
  sortOrder      Int
  overriddenById String?
  overrideReason String?
  overriddenAt   DateTime?
  createdAt      DateTime  @default(now())

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  overriddenBy User?   @relation("ProjectPhaseOverriddenBy", fields: [overriddenById], references: [id])

  mainTasks MainTask[]

  @@unique([projectId, name])
  @@index([projectId, sortOrder])
}

model MainTask {
  id             String      @id @default(cuid())
  projectId      String
  /// Which stage gate this task sits behind. Null means unphased — never gated.
  phaseId        String?
  title          String
  description    String
  priority       Priority    @default(MEDIUM)
  startDate      DateTime?
  deadline       DateTime
  /// Derived from the discipline tasks and cached — never set by hand.
  status         TaskStatus  @default(NOT_STARTED)
  /// Derived from the discipline tasks and cached — never set by hand.
  progressPct    Int         @default(0)
  statusOverride TaskStatus?
  overriddenById String?
  overrideReason String?
  overriddenAt   DateTime?
  createdById    String
  ownerId        String?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  project      Project @relation(fields: [projectId], references: [id])
  // Restrict, not SetNull: a phase may only be deleted once no main task references it, and the
  // service says so in plain English rather than silently unphasing somebody's work.
  phase        ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  createdBy    User    @relation("MainTaskCreatedBy", fields: [createdById], references: [id])
  owner        User?   @relation("MainTaskOwner", fields: [ownerId], references: [id])
  overriddenBy User?   @relation("MainTaskOverriddenBy", fields: [overriddenById], references: [id])

  disciplineTasks DisciplineTask[]
  documents       Document[]
  comments        Comment[]
  favorites       Favorite[]

  @@index([projectId, deletedAt])
  @@index([projectId, deadline])
  @@index([deadline])
}

model DisciplineTask {
  id            String     @id @default(cuid())
  mainTaskId    String
  disciplineId  String
  title         String
  description   String?
  assigneeId    String?
  assignedById  String?
  startDate     DateTime?
  deadline      DateTime
  status        TaskStatus @default(NOT_STARTED)
  priority      Priority   @default(MEDIUM)
  isMandatory   Boolean    @default(true)
  completedAt   DateTime?
  completedById String?
  sortOrder     Int        @default(0)
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  mainTask    MainTask   @relation(fields: [mainTaskId], references: [id])
  discipline  Discipline @relation(fields: [disciplineId], references: [id])
  assignee    User?      @relation("DisciplineTaskAssignee", fields: [assigneeId], references: [id])
  assignedBy  User?      @relation("DisciplineTaskAssignedBy", fields: [assignedById], references: [id])
  completedBy User?      @relation("DisciplineTaskCompletedBy", fields: [completedById], references: [id])

  requiredDocuments RequiredDocument[]
  documents         Document[]
  comments          Comment[]
  predecessorEdges  TaskDependency[]   @relation("DependencySuccessor")
  successorEdges    TaskDependency[]   @relation("DependencyPredecessor")
  favorites         Favorite[]

  @@index([mainTaskId, deletedAt])
  @@index([assigneeId, status, deadline])
  @@index([disciplineId])
  @@index([deadline])
}

model TaskDependency {
  id            String   @id @default(cuid())
  predecessorId String
  successorId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  predecessor DisciplineTask @relation("DependencyPredecessor", fields: [predecessorId], references: [id])
  successor   DisciplineTask @relation("DependencySuccessor", fields: [successorId], references: [id])

  @@unique([predecessorId, successorId])
  @@index([successorId])
}

model RequiredDocument {
  id               String    @id @default(cuid())
  disciplineTaskId String
  name             String
  description      String?
  isMandatory      Boolean   @default(true)
  documentId       String?
  satisfiedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  disciplineTask DisciplineTask @relation(fields: [disciplineTaskId], references: [id])
  document       Document?      @relation(fields: [documentId], references: [id])

  @@index([disciplineTaskId])
}

/// Exactly one of mainTaskId / disciplineTaskId is set — enforced in the service layer.
model Document {
  id               String    @id @default(cuid())
  projectId        String
  mainTaskId       String?
  disciplineTaskId String?
  title            String
  category         String?
  currentVersionId String?
  uploadedById     String
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project        Project         @relation(fields: [projectId], references: [id])
  mainTask       MainTask?       @relation(fields: [mainTaskId], references: [id])
  disciplineTask DisciplineTask? @relation(fields: [disciplineTaskId], references: [id])
  uploadedBy     User            @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  versions          DocumentVersion[]
  requiredDocuments RequiredDocument[]

  @@index([projectId, deletedAt])
  @@index([mainTaskId])
  @@index([disciplineTaskId])
}

/// IMMUTABLE: rows are only ever inserted. The service layer never updates or deletes a version.
model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  revisionNumber   Int
  storedFilename   String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String
  uploadedById     String
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  document   Document @relation(fields: [documentId], references: [id])
  uploadedBy User     @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id])

  @@unique([documentId, revisionNumber])
}

/// Exactly one of mainTaskId / disciplineTaskId is set — enforced in the service layer.
model Comment {
  id               String    @id @default(cuid())
  body             String
  authorId         String
  mainTaskId       String?
  disciplineTaskId String?
  mentions         String[]
  editedAt         DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  author         User            @relation(fields: [authorId], references: [id])
  mainTask       MainTask?       @relation(fields: [mainTaskId], references: [id])
  disciplineTask DisciplineTask? @relation(fields: [disciplineTaskId], references: [id])

  @@index([mainTaskId])
  @@index([disciplineTaskId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  linkUrl   String
  actorId   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id])
  actor User? @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([userId, readAt, createdAt(sort: Desc)])
  /// The hourly sweep asks "have I already told this person about this task?" by type + link.
  @@index([type, linkUrl])
}

/// APPEND-ONLY audit trail. Rows are only ever inserted — no update or delete path exists.
model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  projectId  String?
  entityType String
  entityId   String
  action     String
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor   User?    @relation(fields: [actorId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([projectId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

/// A person's own shortcuts in the sidebar. Exactly one of projectId / mainTaskId /
/// disciplineTaskId is set — enforced in the database by the `favorite_one_target` CHECK
/// constraint added in the favorites_and_personal_tasks migration.
/// Personal preference, not project work: no ActivityLog row is ever written for one.
model Favorite {
  id               String   @id @default(cuid())
  userId           String
  projectId        String?
  mainTaskId       String?
  disciplineTaskId String?
  createdAt        DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mainTask       MainTask?       @relation(fields: [mainTaskId], references: [id], onDelete: Cascade)
  disciplineTask DisciplineTask? @relation(fields: [disciplineTaskId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@unique([userId, mainTaskId])
  @@unique([userId, disciplineTaskId])
  @@index([userId, createdAt])
}

/// A person's private to-do list in the sidebar. Never shared, never audited — it is not project work.
model PersonalTask {
  id          String    @id @default(cuid())
  userId      String
  title       String
  done        Boolean   @default(false)
  sortOrder   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}
